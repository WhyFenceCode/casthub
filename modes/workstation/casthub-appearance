#!/bin/bash
# Publish this user's light/dark preference so the login screen can match it.
# Runs as the user (systemd user units casthub-appearance.{service,path}).
# Reads the Plasma window background from kdeglobals; dark if its luminance < 50%.
# Writes only "light" or "dark" to $dir/$USER (dir: root-owned, mode 1733).
set -u
cfg=${XDG_CONFIG_HOME:-$HOME/.config}/kdeglobals
dir=${CASTHUB_APPEARANCE_DIR:-/var/lib/casthub/appearance}
user=${USER:-$(id -un)}

rgb=$(awk -F= '/^\[/ { s = ($0 == "[Colors:Window]") } s && $1 == "BackgroundNormal" { print $2; exit }' "$cfg" 2>/dev/null)
IFS=, read -r r g b _ <<<"${rgb:-239,240,241}"   # Plasma default (Breeze Light) if unset
lum=$(( (${r:-239} * 299 + ${g:-240} * 587 + ${b:-241} * 114) / 1000 ))
scheme=light
[ "$lum" -lt 128 ] && scheme=dark

[ -d "$dir" ] || exit 0
tmp=$(mktemp "$dir/.$user.XXXXXX") || exit 1
printf '%s\n' "$scheme" > "$tmp" && chmod 644 "$tmp" && mv -f "$tmp" "$dir/$user"
