#!/bin/bash
# Close the Display panel (casthub-display): end any cast, then quit its nested Sway.
# Exits 1 when no panel is open (Console's Ctrl+Alt+Esc then leaves Console instead).
set -u
run=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
state="$run/casthub-panel.swaysock"
[ -e "$state" ] || exit 1
sock=$(cat "$state")
if ! SWAYSOCK=$sock swaymsg -t get_version >/dev/null 2>&1; then
  rm -f "$state"
  exit 1
fi
# The hub ends its casts on SIGTERM (RTSP teardown to each PC); give it a moment.
if pkill -TERM -u "$(id -u)" -f 'casthub\.hub\.__main__'; then
  for _ in $(seq 20); do
    pgrep -u "$(id -u)" -f 'casthub\.hub\.__main__' >/dev/null || break
    sleep 0.2
  done
fi
SWAYSOCK=$sock swaymsg exit >/dev/null 2>&1
rm -f "$state"
exit 0
