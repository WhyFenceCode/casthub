#!/bin/bash
# casthub-display: Display mode as a panel inside Workstation or Console.
#
# Runs a nested Sway (one window) with the Display UI and the receiver hub, so the
# machine takes casts without leaving the current session. Ctrl+Alt+Esc, or "Close" in the
# panel's bar, closes the panel and ends any cast (casthub-panel-close). The real Display mode
# from the login screen is unchanged.
#
#   casthub-display [--capture FILE]
#     --capture FILE  also save the PC's video stream, exactly as received, to FILE (debugging;
#                     it holds whatever the PC shows, so keep it under local/ and delete it after)
#   casthub-display --screens N [--capture FILE]
#     N screens (1-4) in the panel, one window each, all mirroring the one receiver (layout
#     mirror_all; M4 showed Windows lists one receiver per radio). Placed side by side.
#   casthub-display --kill
#     close the panel and stop every panel process of this user, also stuck or orphaned ones
#     (SIGTERM, then SIGKILL). Display mode's own hub (casthub-hub.service) is left alone.
set -u
capture=""
run=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
state="$run/casthub-panel.swaysock"

# The panel's processes: hub restart loop first (so it doesn't start a new hub), then hub,
# video players, the hub's UxPlay, UI and the nested Sway.
PATTERNS=('while \[ -S "\$SWAYSOCK" \]; do /usr/libexec/casthub/casthub-hub'
          'casthub\.hub\.__main__' 'casthub\.media\.player' 'uxplay .*-vrtp config-interval=1 ! udpsink host=127\.0\.0\.1'
          'casthub\.ui\.app'
          'sway -c /usr/share/casthub/display/panel\.conf')

panel_pids() {
  local p pid
  for p in "${PATTERNS[@]}"; do pgrep -u "$(id -u)" -f -- "$p"; done | sort -un | while read -r pid; do
    # Display mode's hub runs as a user service: not ours to kill.
    grep -qs 'casthub-hub\.service' "/proc/$pid/cgroup" || echo "$pid"
  done
}

kill_panel() {
  /usr/libexec/casthub/casthub-panel-close >/dev/null 2>&1 || true     # the gentle way first
  local pids n
  pids=$(panel_pids)
  if [ -z "$pids" ]; then
    rm -f "$state"
    echo "casthub-display: no panel processes running"
    return 0
  fi
  n=$(wc -w <<<"$pids")
  # shellcheck disable=SC2086
  kill -TERM $pids 2>/dev/null
  for _ in $(seq 15); do
    [ -z "$(panel_pids)" ] && break
    sleep 0.2
  done
  pids=$(panel_pids)
  if [ -n "$pids" ]; then
    echo "casthub-display: $(wc -w <<<"$pids") process(es) ignored SIGTERM; killing them"
    # shellcheck disable=SC2086
    kill -KILL $pids 2>/dev/null
    sleep 0.3
  fi
  rm -f "$state"
  logger -t casthub-display "kill: stopped $n panel process(es)"
  if pids=$(panel_pids) && [ -n "$pids" ]; then
    echo "casthub-display: still running: $pids" >&2
    return 1
  fi
  echo "casthub-display: stopped $n panel process(es)"
}

if [ "${1:-}" = --kill ]; then
  kill_panel
  exit
fi
screens=1
while [ $# -gt 0 ]; do
  case "$1" in
    --capture)
      [ -n "${2:-}" ] || { echo "casthub-display: --capture needs a file" >&2; exit 2; }
      capture=$(realpath -m -- "$2")
      mkdir -p -- "$(dirname -- "$capture")"
      shift 2 ;;
    --screens)
      case "${2:-}" in [1-4]) screens=$2 ;; *) echo "casthub-display: --screens takes 1 to 4" >&2; exit 2 ;; esac
      shift 2 ;;
    *) echo "casthub-display: unknown option $1 (see the top of $0)" >&2; exit 2 ;;
  esac
done
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
  echo "casthub-display: run it inside Workstation or Console (needs a Wayland session)" >&2
  exit 1
fi
if [ -e "$state" ] && SWAYSOCK=$(cat "$state") swaymsg -t get_version >/dev/null 2>&1; then
  echo "casthub-display: the Display panel is already open (Ctrl+Alt+Esc closes it)" >&2
  exit 0
fi
if ss -Hltn 'sport = :7250' 2>/dev/null | grep -q .; then
  if [ -n "$(panel_pids)" ]; then
    echo "casthub-display: a panel hub is still running without its panel (stuck?)." >&2
    echo "  casthub-display --kill   stops it" >&2
  else
    echo "casthub-display: a receiver is already running on this machine (Display mode?)" >&2
  fi
  exit 1
fi
rm -f "$state"
logger -t casthub-display "opening the Display panel"
# Sway sets SWAYSOCK for its own children; drop the outer one (Console) so nothing mixes them.
if [ -n "$capture" ]; then
  echo "casthub-display: saving the PC's stream to $capture"
  logger -t casthub-display "saving the PC's stream (capture on)"
fi
[ "$screens" -gt 1 ] && logger -t casthub-display "$screens screens (mirrored)"
outer_sway=${SWAYSOCK:-}
# WLR_WL_OUTPUTS: the nested Sway opens one window per output, and the hub sees N screens.
env -u SWAYSOCK -u I3SOCK CASTHUB_CAPTURE="$capture" WLR_BACKENDS=wayland WLR_WL_OUTPUTS="$screens" \
  sway -c /usr/share/casthub/display/panel.conf 2>&1 | systemd-cat -t casthub-panel &
panel=$!
# In Console (Sway) the panel rule makes the window fullscreen; with several, tile them instead.
# (Workstation: the KWin views script places them side by side.)
if [ "$screens" -gt 1 ] && [ -n "$outer_sway" ]; then
  for _ in $(seq 20); do
    sleep 0.5
    [ "$(SWAYSOCK=$outer_sway swaymsg -t get_tree 2>/dev/null | grep -c '"app_id": "wlroots"')" -ge "$screens" ] && break
  done
  SWAYSOCK=$outer_sway swaymsg '[app_id="wlroots"] fullscreen disable' >/dev/null 2>&1
fi
wait "$panel"
rm -f "$state"
logger -t casthub-display "Display panel closed"
