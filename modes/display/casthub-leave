#!/bin/bash
# Ctrl+Alt+Esc in Display mode (bound in modes/display/sway.conf).
# Asks the Display UI to open the PIN page (SPEC D7). With --now (the UI calls this after
# the PIN), or if the UI isn't running, it leaves straight away: back to the login screen,
# which still needs a password for everything except Display.
if [ "${1:-}" != --now ]; then
  sock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/casthub-ui.sock"
  if python3 -I - "$sock" <<'PY'
import socket, sys
s = socket.socket(socket.AF_UNIX)
s.settimeout(2)
s.connect(sys.argv[1])
s.sendall(b'{"cmd": "pin"}\n')
sys.exit(0 if b'"ok": true' in s.recv(256) else 1)
PY
  then exit 0; fi
  logger -t casthub-leave "display UI not answering; leaving without the PIN page"
fi
logger -t casthub-leave "leaving display mode"
systemctl --user stop casthub-display.target 2>/dev/null
exec swaymsg exit
