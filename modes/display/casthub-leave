#!/bin/bash
# Ctrl+Alt+Esc in Display mode (bound in modes/display/sway.conf).
# Asks the Display UI to open the leave page (SPEC D7: return to login / restart / shut
# down, no PIN), after ending any cast. With --now (the UI calls this), or if the UI isn't running, it leaves
# straight away: back to the login screen.
if [ "${1:-}" != --now ]; then
  # End any cast first: the video window is fullscreen and would hide the leave page.
  systemctl --user kill --signal=USR1 casthub-hub.service 2>/dev/null
  sock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/casthub-ui.sock"
  if python3 -I - "$sock" <<'PY'
import socket, sys
s = socket.socket(socket.AF_UNIX)
s.settimeout(2)
s.connect(sys.argv[1])
s.sendall(b'{"cmd": "leave"}\n')
sys.exit(0 if b'"ok": true' in s.recv(256) else 1)
PY
  then exit 0; fi
  logger -t casthub-leave "display UI not answering; leaving directly"
fi
logger -t casthub-leave "leaving display mode"
systemctl --user stop casthub-display.target 2>/dev/null
exec swaymsg exit
