#!/bin/sh
# Start the receiver hub (casthub/hub), installed under /usr/lib/casthub.
# Run by casthub-hub.service (user) in Display mode; log: journalctl --user -u casthub-hub
exec python3 -I -c 'import sys; sys.path.insert(0, "/usr/lib/casthub"); from casthub.hub.__main__ import main; raise SystemExit(main())' "$@"
