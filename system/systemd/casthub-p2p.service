[Unit]
Description=Cast Hub Wi-Fi Direct (Miracast discovery and P2P groups)
After=wpa_supplicant.service NetworkManager.service
Wants=wpa_supplicant.service

[Service]
ExecStart=/usr/libexec/casthub/casthub-p2p
Restart=on-failure
RestartSec=5
RuntimeDirectory=casthub
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
# /run/NetworkManager: the wpa_supplicant config with a new Wi-Fi Direct address (p2pd.new_address);
# wpa_supplicant (SELinux NetworkManager_t) can read files there.
ReadWritePaths=/run/casthub /run/NetworkManager
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
