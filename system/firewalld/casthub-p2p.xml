<?xml version="1.0" encoding="utf-8"?>
<!-- Wi-Fi Direct group interfaces while a PC casts over Wi-Fi Direct (set by casthub-p2p).
     Only what the cast needs: DHCP for the PC, and the RTP ports the receivers listen on. -->
<zone>
  <short>Cast Hub Wi-Fi Direct</short>
  <description>A PC casting to Cast Hub over Wi-Fi Direct.</description>
  <service name="dhcp"/>
  <port protocol="udp" port="1028-1099"/>
</zone>
